<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fukaha" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorBackground">@color/fukaha_surface</item>
        <item name="android:windowBackground">@color/fukaha_surface</item>
        <item name="android:windowAnimationStyle">@style/Theme.Fukaha.LocaleAnimation</item>
    </style>

    <!-- Locale recreation must not fade through the default black activity preview. -->
    <style name="Theme.Fukaha.LocaleAnimation">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>

    <style name="Theme.Fukaha.Transparent" parent="Theme.Fukaha">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
